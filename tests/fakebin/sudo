#!/usr/bin/env bash
# Offline canary fake. Never switches identity, executes a probe or uses sudo.
set -euo pipefail
bad() { printf 'invalid fake sudo arguments\n' >&2; exit 97; }
# Sandbox adapter pass-through (issue #24): `sudo -n -u <worker>
# [--preserve-env=NAME] -- <launcher> <mode> ...` drops its options and
# runs the command. The canary shape below (`-n -H -u`) is untouched.
if [[ "${1:-}" == '-n' && "${2:-}" == '-u' ]]; then
  [[ $# -ge 5 ]] || bad
  shift 3
  while [[ "${1:-}" == --preserve-env=* ]]; do shift; done
  [[ "${1:-}" == '--' ]] || bad
  shift
  [[ "${FAKE_SUDO_FAILURE:-0}" == '0' ]] || exit 1
  exec "$@"
fi
[[ $# -ge 7 ]] || bad
[[ "$1" == '-n' && "$2" == '-H' && "$3" == '-u' ]] || bad
[[ "$4" == 'synthetic-worker' && "$5" == '--' ]] || bad
shift 5
if [[ "$1" == '/usr/bin/id' ]]; then
  [[ $# == 2 && "$2" == '-u' ]] || bad
  [[ "${FAKE_SUDO_FAILURE:-0}" == '0' ]] || exit 1
  printf '%s\n' "${FAKE_WORKER_UID:-54321}"
  exit 0
fi
[[ $# == 6 && "$1" == '/usr/bin/python3' && "$2" == '-I' && "$3" == '-c' ]] || bad
[[ "$4" == *'except PermissionError:'* && -n "$6" ]] || bad
[[ "${FAKE_SUDO_FAILURE:-0}" == '0' ]] || exit 1
[[ "${FAKE_PROBE_ERROR:-0}" == '0' ]] || exit 70
case "$5" in
  inside-write) [[ "${FAKE_INSIDE_DENIED:-0}" == '0' ]] && exit 0 || exit 13 ;;
  private-read|outside-write|owner-config)
    [[ "${FAKE_ALLOW:-}" == "$5" ]] && exit 0 || exit 13 ;;
  *) bad ;;
esac
