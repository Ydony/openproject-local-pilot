#!/usr/bin/env bash
#
# bin/opl-logs -- show pilot logs without exposing secret values.
# Thin wrapper around "compose logs" with a bounded default tail.

set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/../lib/common.sh"

usage() {
  cat <<'EOF'
Usage: opl-logs [--tail N] [--follow] [SERVICE...]

Shows logs for all services (default) or the named ones.
No secret values are printed by this wrapper itself.
EOF
}

TAIL=200
FOLLOW=()
SERVICES=()
while [ $# -gt 0 ]; do
  case "$1" in
    --tail) TAIL="${2:?missing value}"; shift ;;
    --follow | -f) FOLLOW=(--follow) ;;
    -h | --help) usage; exit 0 ;;
    -*) opl_die "unknown argument: $1. See opl-logs --help." ;;
    *) SERVICES+=("$1") ;;
  esac
  shift
done

need_cmd docker
require_runtime

compose logs "${FOLLOW[@]:+${FOLLOW[@]}}" --tail "$TAIL" "${SERVICES[@]:+${SERVICES[@]}}"
