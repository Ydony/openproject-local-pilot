# Example environment for the OpenProject localhost pilot.
# Copying this file is NOT required: bin/opl-setup generates the real runtime
# .env (with random secrets) inside the ignored .opl-runtime/ directory.
# Every value below is a placeholder or a safe localhost default.

# Loopback-only publish address. Never change 127.0.0.1 to 0.0.0.0:
# the pilot must stay reachable from this machine only.
PORT=127.0.0.1:8080
# Localhost over plain HTTP behind the loopback proxy.
OPENPROJECT_HTTPS=false
# Image tag tracking the upstream stable branch used by this toolkit.
TAG=17-slim
# Generated on first setup. Placeholder on purpose: never commit a real value.
SECRET_KEY_BASE=CHANGE_ME_GENERATED_BY_SETUP
# Generated on first setup. Placeholder on purpose: never commit a real value.
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_BY_SETUP
